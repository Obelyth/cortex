# ---- required ---------------------------------------------------------------
# Your private brain repo (owner/name). Created for you by `npm run onboard`.
BRAIN_REPO=

# Fine-grained GitHub PAT: Contents read/write, scoped to ONLY the brain repo.
# github.com/settings/personal-access-tokens/new
GITHUB_TOKEN=

# Bearer for header-capable clients (Claude Code). Generate: openssl rand -hex 32
MCP_TOKEN=

# ---- required for claude.ai / iOS / desktop --------------------------------
# Secret URL segment for clients that cannot send headers. openssl rand -hex 32
# Also gates the console and the live map.
CONNECTOR_PATH_SECRET=

# ---- required for brain_ask -------------------------------------------------
# The reader model. Without it, brain_ask errors; every other tool still works.
ANTHROPIC_API_KEY=

# ---- optional ---------------------------------------------------------------
BRAIN_BRANCH=main
BRAIN_TZ=UTC
SENTRY_DSN=
