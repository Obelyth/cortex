# Cortex configuration reference. Copy to .env.local for local development.
# Never commit real values. Config identifies a resource or preference; Secret
# grants access. Neither label changes environment scope or deployment timing.
# Keep every credential server-side; never add a NEXT_PUBLIC_ prefix.
# On Vercel, select Production for your live app and Preview only for intended
# preview use. Save changes, then deploy that environment to make them active.
# Saving or refreshing Settings does not deploy or prove provider permission.

# --- notes and trusted access -----------------------------------------------
# Config: owner/repository of YOUR notes. Onboarding can create this private
# repository from the blank brain-template. This is not the Cortex app repository.
BRAIN_REPO=your-github-user/brain
# Secret: GitHub token authorized for that notes repository.
# Read operations need Contents read; note capture/edit requires Contents write.
GITHUB_TOKEN=
# Config: notes branch and IANA timezone for daily log boundaries.
# BRAIN_BRANCH=main
# BRAIN_TZ=UTC

# Secret: bearer for /api/mcp. Generate a distinct random value.
# Blank or whitespace-only is refused at request time.
MCP_TOKEN=
# Secret: path credential for header-less trusted connectors.
# Endpoint: /api/s/<CONNECTOR_PATH_SECRET>/mcp
CONNECTOR_PATH_SECRET=
# Secret: console passcode, separate from the path secret. Blank locks the console.
# Rotating either value invalidates existing console device sessions.
CONSOLE_PASSCODE=

# --- answering model --------------------------------------------------------
# Secret: required for answers generated by the default Claude reader.
# Model-free note and retrieval operations do not require a reader API key.
ANTHROPIC_API_KEY=
# Secret: configure only additional reader providers you use.
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# Config: optional deployment-default model from lib/reader.ts's allowlist.
# READER_MODEL=

# --- optional durable settings and guest access -----------------------------
# Config: Upstash HTTPS REST endpoint. Secret: REST token for the same database.
# Durable preference saves and metered guest access require this store.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# Secret: a SECOND path credential for the restricted read/propose guest door.
# It must differ from CONNECTOR_PATH_SECRET. Blank disables guest access.
# Endpoint: /api/g/<GUEST_PATH_SECRET>/mcp
GUEST_PATH_SECRET=

# --- optional mirror, working state and dashboard receipts ------------------
# Config: hosted Supabase Project URL from your project API settings.
# Secret: service_role key from the same project's API keys.
# This key bypasses row-level security. Never expose it to browser code.
# Git remains the notes authority; the mirror is an optional serving tier.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# A new database needs administrator-reviewed pristine bootstrap outside the
# browser before working state, Ops jobs and configuration receipts can persist.
# Follow docs/database-bootstrap.md. Never bootstrap over existing data or
# invent migration ledger rows. The Settings form does not create this schema.

# --- optional customer-owned checks, migrations and deployments -------------
# Config: application source, distinct from BRAIN_REPO above.
# Use your Cortex fork's owner/repository and approved application branch.
CORTEX_APP_REPO=
CORTEX_APP_BRANCH=
# Secret: dedicated selected-repository GitHub token with Actions read/write
# and Contents read. Do not reuse the notes token. The fixed
# .github/workflows/cortex-dashboard-checks.yml must exist on the default
# branch and the configured application branch.
CORTEX_ACTIONS_TOKEN=

# Secret: dedicated Vercel account/team token from account settings > Tokens.
# Presence is not proof that the token can manage variables or deploy.
CORTEX_VERCEL_TOKEN=
# Config: Project ID from Vercel project settings, beginning prj_. This is an ID,
# not a token, project name or URL. Cortex pins requests to this project.
CORTEX_VERCEL_PROJECT_ID=
# Config: optional Team ID beginning team_, from team settings. Set for a
# team-owned project; leave blank for a personal project.
CORTEX_VERCEL_TEAM_ID=
# Link the app repository and enable Vercel System Environment Variables in
# project settings. Never fabricate the VERCEL or VERCEL_ENV platform indicators.
# Dashboard secret entry requires Vercel-managed HTTPS ingress, these management
# grants and the database receipt schema. Set those prerequisites in provider
# settings first, then deploy from Vercel. The browser cannot grant itself access.

# Config: supabase:<20-letter-project-ref>:postgres, matching SUPABASE_URL.
# This identifies the database; it grants no database access.
CORTEX_MIGRATION_TARGET=
# Secret, administrator/workflow ONLY: SUPABASE_DB_URL connection string from
# your Supabase project's Connect dialog. Do not add it to the deployed app.
# Store it in your repository's protected cortex-database GitHub environment.
# Restrict that environment to the approved app branch and require review.
# Both dashboard migration checks and applies use that protected environment.
# SUPABASE_DB_URL=
# Secret, workflow ONLY: optional trusted PEM CA for that database connection.
# Keep with SUPABASE_DB_URL. Never disable TLS certificate verification.
# CORTEX_DATABASE_CA=

# --- optional Ops reports, scheduled sweep and email -------------------------
# Secret: bearer for POST /api/ops/report, at least 32 characters.
# Generate separately from MCP_TOKEN.
OPS_TOKEN=
# Secret: bearer for the Ops sweep cron. Configure through your hosting
# provider's cron authentication; the app checks this exact value.
CRON_SECRET=
# Secret: Resend API key VALUE under the exact name RESEND_API_KEY.
# An integration's CORTEX_RESEND_API_KEY is not read by the mailer.
RESEND_API_KEY=
# Config: one recipient email address. Resend Contacts do not set this value.
OPS_ALERT_TO=
# Config: sender address or Name <email@example.com>. Use the singular name.
# The dashboard Alerts form requires all three fields. Manual provider setup
# can omit OPS_ALERT_FROM to use Cortex <onboarding@resend.dev>; for production
# use a sender/domain authorized by your Resend account. Saving sends no email.
OPS_ALERT_FROM=

# --- optional learning defaults ---------------------------------------------
# Config: explicit tool arguments take precedence where supported, then saved
# console preferences, then these deployment defaults, then built-in defaults.
# Invalid settings are reported and ignored. No model training occurs here.
# ANSWER_CACHE=on
# ANSWER_CACHE_TTL_DAYS=7         # 1 to 30
# HANDOFF_BUDGET=24000            # 4000 to 100000 bytes
# WATCH_SUPERSEDED_LINK=on
# WATCH_COACCESS_GAP=on
# WATCH_CORRECTION_CHAIN=on
# COACCESS_FLOOR=5                # 2 to 10

# Config: optional server-side error-reporting destination.
# SENTRY_DSN=
