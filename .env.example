# cortex — copy to .env.local and fill in. No real values belong in this file.

# --- required ---------------------------------------------------------------
# owner/repo of YOUR private brain. `npm run onboard` creates the repo from
# brain-template/ and fills this in for you; the placeholder cannot resolve to a
# real deployment by accident.
BRAIN_REPO=your-github-user/brain
GITHUB_TOKEN=
# Bearer for /api/mcp. Trimmed before comparison; empty or whitespace-only is
# refused at request time. Short tokens are warned about in the log but accepted —
# refusing a deployment's own configured secret locks the operator out.
MCP_TOKEN=
# Required by brain_ask, which calls a reader model on every invocation. Without
# it brain_ask throws; the other tools are unaffected. (Needed for the default
# claude-* readers; see the pluggable-reader block below for the others.)
ANTHROPIC_API_KEY=

# --- required for the claude.ai custom connector ----------------------------
# Header-less clients use /api/s/<CONNECTOR_PATH_SECRET>/mcp instead of a bearer.
CONNECTOR_PATH_SECRET=

# --- required for the web console -------------------------------------------
# The console's second factor. The /s/<CONNECTOR_PATH_SECRET>/... pages no longer
# open on the link alone: a device's first visit gets a passcode prompt, and only
# the right answer stamps it (an httpOnly cookie derived from this value plus the
# path secret — rotate either and every device re-prompts on its next visit).
# Unset/blank = the web console is LOCKED, fail closed, and the entry says so.
# The MCP doors never read this — a connector cannot type into a prompt.
CONSOLE_PASSCODE=

# --- optional: KV store ------------------------------------------------------
# Upstash Redis REST credentials — the durable home for console settings, guest
# policy and budget, proposals, and the call log. Without them, settings and the
# call log fall back to one instance's memory, and the guest door refuses every
# call: metering and proposals have nowhere to live. The "Upstash for Redis"
# integration on the Vercel Marketplace injects exactly these names.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# --- optional: pluggable reader ---------------------------------------------
# The reader model is pluggable — see lib/reader.ts for the allowlist. Fill only
# the keys for providers you actually use; Claude stays the measured default.
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# Deployment-default reader model (callers can still pick per call). Blank = the
# measured default, claude-sonnet-5. An invalid value fails loudly on first ask.
# READER_MODEL=

# --- optional: the guest door -----------------------------------------------
# A SECOND, DIFFERENT secret. /api/g/<GUEST_PATH_SECRET>/mcp serves a reduced
# toolset — read the brain, propose a note, nothing else. Hand this one to an
# assistant you do not control. It must not equal CONNECTOR_PATH_SECRET; the
# route refuses to serve if they match, because a shared secret would mean
# revoking the guest also revokes you. Blank = no guest door exists. The door
# also requires the KV store above — without it every guest call errors.
GUEST_PATH_SECRET=

# --- optional: the Learning knobs -------------------------------------------
# Resolution order everywhere: explicit call argument (where a tool has one), the
# console's Learning section, these env vars, then the code default. Unset/blank
# means "not chosen here" — a deployment with none of these set behaves exactly
# as it did before the knobs existed. An unparseable value is reported on the
# settings screen and ignored, never guessed at.
# ANSWER_CACHE=on                 # off = brain_ask skips both cache lookup and store
# ANSWER_CACHE_TTL_DAYS=7         # 1-30; bounds storage only — the head SHA in the key invalidates
# HANDOFF_BUDGET=24000            # bytes, 4000-100000; a call's own budget argument still wins
# WATCH_SUPERSEDED_LINK=on        # inbox check: live link to a superseded note
# WATCH_COACCESS_GAP=on           # inbox check: co-read pair with no link
# WATCH_CORRECTION_CHAIN=on       # inbox check: correction chain crossing notes
# COACCESS_FLOOR=5                # 2-10 shared windows before the co-read check fires

# --- optional ---------------------------------------------------------------
# Server-side error reporting. Path secrets are scrubbed from events before
# they leave the deployment.
# SENTRY_DSN=
# BRAIN_BRANCH=main
# Day boundary for the daily logs. Defaults to UTC — set your IANA timezone so
# evening captures land in today's log, not tomorrow's.
# BRAIN_TZ=UTC

# Supabase mirror (optional). Unset = corpus served from the GitHub tarball, exactly as before.
# The mirror is a serving tier, never an authority: git remains the source of truth, and the
# backfill is reconcile-from-empty. SUPABASE_DB_URL is for scripts/migrate.ts only — local, never
# deployed.
#
# SERVER-SIDE ONLY. The service-role key bypasses RLS, so it is a full-database credential, not an
# API key. It must never carry a NEXT_PUBLIC_ prefix and must never be read from a component that
# ships to the browser — Next.js inlines NEXT_PUBLIC_ vars into the client bundle at build time,
# which would publish the whole brain to anyone who views source.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=
